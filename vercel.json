{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:prefix+/:dir(css|js|fonts)/:file*", "destination": "/:dir/:file*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]},
    { "source": "/:prefix*/fonts/:file*", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
